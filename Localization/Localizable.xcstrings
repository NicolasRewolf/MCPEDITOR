    },
    " L’inventaire est incomplet ; d’autres liens peuvent manquer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " The inventory is incomplete; other links may be missing."
          }
        }
      }
    },
    " Par sécurité, aucun fichier créé n’a été supprimé automatiquement. Fichiers à vérifier : " : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " For safety, no created file was deleted automatically. Files to check: "

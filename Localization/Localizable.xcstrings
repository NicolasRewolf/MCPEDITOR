      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " free"
          }
        }
      }
    },
    " macOS y a créé une corbeille cachée (.Trashes) dont le contenu ne peut pas être lu." : {
